{
  "name": "inventari-backend",
  "version": "1.0.0",
  "description": "Sistem për Menaxhimin e Inventarit dhe Distribimit të Produkteve Sanitare",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "tsx src/config/migrate.ts",
    "migrate:payments": "tsx src/config/runMigration.ts",
    "migrate:status": "tsx src/config/updatePorosiStatusEnum.ts",
    "seed": "tsx src/config/seed.ts",
    "test:login": "tsx src/config/testLogin.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.6.5",
    "sequelize": "^6.35.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/body-parser": "^1.19.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.19.27",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
